{
  "version": 2,
  "builds": [
    {
      "src": "api/prices.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/history.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/analysis.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/prices", "dest": "/api/prices.js" },
    { "src": "/api/history", "dest": "/api/history.js" },
    { "src": "/api/analysis", "dest": "/api/analysis.js" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
